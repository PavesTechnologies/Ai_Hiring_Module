/*
 * AIRS - CD pipeline (runs on pushes to the dev branch).
 *
 * Mirrors User_Management_System/Jenkinsfile.cd. deployToDev from the shared
 * library's dev branch does:
 *   checkout -> notify -> buildx build --platform linux/arm64
 *   --file arm.Dockerfile -> push to ECR -> ssh to EC2 and sync secrets ->
 *   rewrite k8s/backend/airs/deployment.yaml in intranet-devops@dev
 *   -> ArgoCD deploys.
 *
 * WHY deployToDev AND NOT deployToDevPython, despite this being Python:
 * the two differ in exactly one way that matters here - deployToDev builds
 * `--platform linux/arm64`, deployToDevPython builds `--platform linux/amd64`
 * (both, confusingly, with `--file arm.Dockerfile`). AIRS targets arm64, so
 * deployToDev is the correct one. UMS's own Jenkinsfile.cd calls deployToDev
 * for the same reason, so this also matches house practice.
 *
 * serviceType 'python' only suppresses the Maven build step; everything else
 * in deployToDev is language-agnostic.
 *
 * The @dev library ref is required, not cosmetic: the shared library's main
 * branch has an older deployToDev that builds from a plain `Dockerfile` and
 * lacks the PR-build guard. Pinning @dev gets the arm64 + arm.Dockerfile
 * version this repo is built for.
 */

@Library('paves-shared-lib') _

deployToDev(
  serviceName: 'airs',
  serviceType: 'python',
  ecrRepo:     'paves/airs-dev',
  branch:      'dev'
)
